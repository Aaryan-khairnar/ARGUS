<?xml version="1.0"?>
<sdf version="1.6">
  <model name="moon_terrain">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <heightmap>
            <uri>model://moon_terrain/gazebo_moon_terrain.tif</uri>
            <size>500 500 30</size> 
            <pos>0 0 0</pos>
          </heightmap>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <heightmap>
            <uri>model://moon_terrain/gazebo_moon_terrain.tif</uri>
            <size>500 500 30</size>
            <pos>0 0 0</pos>
            <texture>
              <diffuse>model://moon_terrain/gray_texture.jpg</diffuse>
              <size>10</size> 
            </texture>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>